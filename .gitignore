# Solvers and accessors come from the Bevara registry at build time
# (scripts/fetch-accessors.mjs, run by the Pages workflow). They are not
# committed.
*.wasm
mm_solver_*.js
# the scripts that define the elements, published as bevara:universal-tags
universal-*_1.js
art-player_*.js
accessors/fetched.json
accessors/index.json
.cache/

# ...except the ones the registry does not publish, which cannot be fetched
# (scripts/accessors.json, "local"), and MediaInfo, which is not ours.
