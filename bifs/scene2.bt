InitialObjectDescriptor {
 objectDescriptorID 1
 audioProfileLevelIndication 255
 visualProfileLevelIndication 255
 sceneProfileLevelIndication 254
 graphicsProfileLevelIndication 255
 esDescr [
  ES_Descriptor {
   ES_ID 1
   decConfigDescr DecoderConfigDescriptor {
    streamType 3
    decSpecificInfo BIFSConfig {
     isCommandStream true
     pixelMetric true
     pixelWidth 320
     pixelHeight 240
    }
   }
  }
 ]
}

OrderedGroup {
 children [
  Background2D { backColor 0.1 0.1 0.25 }
  Transform2D {
   translation 0 40
   children [
    Shape {
     appearance Appearance { material Material2D { emissiveColor 0.9 0.6 0.1 filled TRUE } }
     geometry Rectangle { size 180 90 }
    }
   ]
  }
 ]
}
